<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.proyect.viewController.PerfilHuespedViewController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <Label text="Mi perfil" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <GridPane hgap="10" vgap="10">
        <Label text="Documento:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="lblDocumento" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Usuario:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="lblUsuario" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Fecha de nacimiento:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="lblNacimiento" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Nombre:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" prefWidth="300" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Correo:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtCorreo" prefWidth="300" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Label text="Teléfono:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTelefono" prefWidth="300" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        <Label text="Fotografía (opcional):" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <HBox spacing="8" GridPane.rowIndex="6" GridPane.columnIndex="1">
            <TextField fx:id="txtFoto" prefWidth="300" editable="false"/>
            <Button text="Elegir..." onAction="#elegirFoto"/>
        </HBox>
    </GridPane>
    <Button text="Guardar cambios" onAction="#guardar"/>
    <Label fx:id="lblMensaje" wrapText="true"/>
</VBox>
