<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.proyect.viewController.ReportesAdminViewController">
    <padding>
        <Insets top="12" right="16" bottom="12" left="16"/>
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Periodo desde:"/>
        <DatePicker fx:id="dpInicio"/>
        <Label text="hasta:"/>
        <DatePicker fx:id="dpFin"/>
    </HBox>
    <HBox spacing="8">
        <Button text="Ingresos" onAction="#ingresos"/>
        <Button text="Ocupación" onAction="#ocupacion"/>
        <Button text="Reservas por canal" onAction="#porCanal"/>
        <Button text="Saldos pendientes" onAction="#saldos"/>
        <Button text="Apartamentos con más novedades" onAction="#novedades"/>
    </HBox>
    <TextArea fx:id="txtReporte" editable="false" VBox.vgrow="ALWAYS"/>
</VBox>
