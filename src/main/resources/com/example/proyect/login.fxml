<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.proyect.viewController.LoginViewController">
    <padding>
        <Insets top="24" right="32" bottom="24" left="32"/>
    </padding>
    <Label text="Aparta-Suites UQ" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label text="Sistema de Gestión de Alojamiento"/>
    <TextField fx:id="txtUsuario" promptText="Usuario"/>
    <PasswordField fx:id="txtContrasena" promptText="Contraseña" onAction="#iniciarSesion"/>
    <Button text="Ingresar" onAction="#iniciarSesion" defaultButton="true" maxWidth="Infinity"/>
    <Label fx:id="lblMensaje" wrapText="true" style="-fx-text-fill: #b00020;"/>
</VBox>