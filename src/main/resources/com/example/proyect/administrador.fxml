<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyect.viewController.AdministradorViewController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #e8eef2;">
            <padding>
                <Insets top="10" right="16" bottom="10" left="16"/>
            </padding>
            <Label fx:id="lblBienvenida" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cerrar sesión" onAction="#cerrarSesion"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Recepcionistas">
                <content><fx:include source="recepcionistasAdmin.fxml"/></content>
            </Tab>
            <Tab text="Apartamentos">
                <content><fx:include source="apartamentosAdmin.fxml"/></content>
            </Tab>
            <Tab text="Temporadas">
                <content><fx:include source="temporadasAdmin.fxml"/></content>
            </Tab>
            <Tab text="Política">
                <content><fx:include source="politicaAdmin.fxml"/></content>
            </Tab>
            <Tab text="Bloqueos">
                <content><fx:include source="bloqueosAdmin.fxml"/></content>
            </Tab>
            <Tab text="Reportes">
                <content><fx:include source="reportesAdmin.fxml"/></content>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
