<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.proyect.viewController.NuevaReservaRecepcionViewController">
    <padding>
        <Insets top="12" right="16" bottom="12" left="16"/>
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Canal:"/>
        <ComboBox fx:id="cmbCanal" prefWidth="110"/>
        <Label text="Código externo:"/>
        <TextField fx:id="txtCodigoExterno" prefWidth="120"/>
        <Label text="Apartamento:"/>
        <ComboBox fx:id="cmbApartamento" prefWidth="250"/>
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Entrada:"/>
        <DatePicker fx:id="dpEntrada"/>
        <Label text="Salida:"/>
        <DatePicker fx:id="dpSalida"/>
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Documento titular:"/>
        <TextField fx:id="txtDocumento" prefWidth="110"/>
        <Button text="Buscar" onAction="#buscarHuesped"/>
        <TextField fx:id="txtNombreH" promptText="Nombre" prefWidth="150"/>
        <TextField fx:id="txtCorreoH" promptText="Correo" prefWidth="150"/>
        <TextField fx:id="txtTelefonoH" promptText="Teléfono" prefWidth="100"/>
        <DatePicker fx:id="dpNacimientoH" promptText="Nacimiento" prefWidth="130"/>
        <Button text="Registrar huésped" onAction="#registrarHuesped"/>
    </HBox>
    <Label fx:id="lblHuesped" wrapText="true"/>
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Ocupante:"/>
        <TextField fx:id="txtNombreOcupante" promptText="Nombre" prefWidth="170"/>
        <DatePicker fx:id="dpNacimientoOcupante" promptText="Nacimiento"/>
        <Button text="Agregar" onAction="#agregarOcupante"/>
        <Button text="Quitar seleccionado" onAction="#quitarOcupante"/>
    </HBox>
    <ListView fx:id="lstOcupantes" prefHeight="80"/>
    <HBox spacing="8">
        <Button text="Cotizar" onAction="#cotizar"/>
        <Button text="Crear reserva" onAction="#crearReserva"/>
    </HBox>
    <Label fx:id="lblMensaje" wrapText="true"/>
    <TextArea fx:id="txtCotizacion" editable="false" prefHeight="90"/>
    <Label text="Conflictos de canal registrados:"/>
    <ListView fx:id="lstConflictos" prefHeight="70"/>
</VBox>
