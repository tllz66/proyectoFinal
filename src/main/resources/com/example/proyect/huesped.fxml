<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyect.viewController.HuespedViewController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #e8eef2;">
            <padding>
                <Insets top="10" right="16" bottom="10" left="16"/>
            </padding>
            <Label fx:id="lblBienvenida" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cerrar sesión" onAction="#cerrarSesion"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Disponibilidad">
                <VBox spacing="10">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Entrada:"/>
                        <DatePicker fx:id="dpEntrada"/>
                        <Label text="Salida:"/>
                        <DatePicker fx:id="dpSalida"/>
                        <Label text="Personas:"/>
                        <Spinner fx:id="spPersonas" prefWidth="80"/>
                        <Button text="Consultar" onAction="#consultarDisponibles"/>
                    </HBox>
                    <Label fx:id="lblMensaje" wrapText="true"/>
                    <TableView fx:id="tblDisponibles" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="Código" prefWidth="80">
                                <cellValueFactory><PropertyValueFactory property="codigo"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Nombre" prefWidth="160">
                                <cellValueFactory><PropertyValueFactory property="nombre"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Capacidad" prefWidth="90">
                                <cellValueFactory><PropertyValueFactory property="capacidad"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Características" prefWidth="320">
                                <cellValueFactory><PropertyValueFactory property="caracteristicas"/></cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            <Tab text="Cotizar y reservar">
                <VBox spacing="10">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Apartamento:"/>
                        <ComboBox fx:id="cmbApartamento" prefWidth="260"/>
                        <Label text="Entrada:"/>
                        <DatePicker fx:id="dpEntradaR"/>
                        <Label text="Salida:"/>
                        <DatePicker fx:id="dpSalidaR"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Ocupante:"/>
                        <TextField fx:id="txtNombreOcupante" promptText="Nombre" prefWidth="200"/>
                        <Label text="Nació:"/>
                        <DatePicker fx:id="dpNacimientoOcupante"/>
                        <Button text="Agregar" onAction="#agregarOcupante"/>
                        <Button text="Quitar seleccionado" onAction="#quitarOcupante"/>
                    </HBox>
                    <ListView fx:id="lstOcupantes" prefHeight="110"/>
                    <HBox spacing="10">
                        <Button text="Cotizar" onAction="#cotizar"/>
                        <Button text="Crear reserva (Portal)" onAction="#crearReserva"/>
                    </HBox>
                    <Label fx:id="lblMensajeReserva" wrapText="true"/>
                    <TextArea fx:id="txtCotizacion" editable="false" VBox.vgrow="ALWAYS"/>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>