<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.proyect.viewController.PrincipalViewController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label fx:id="lblBienvenida" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label fx:id="lblRol"/>
    <Button text="Cerrar sesión" onAction="#cerrarSesion"/>
</VBox>