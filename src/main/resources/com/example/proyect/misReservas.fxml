<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.proyect.viewController.MisReservasViewController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Actualizar" onAction="#actualizar"/>
    </HBox>
    <TableView fx:id="tblReservas" prefHeight="170">
        <columns>
            <TableColumn fx:id="colCodigo" text="Reserva" prefWidth="90"/>
            <TableColumn fx:id="colApto" text="Apto." prefWidth="70"/>
            <TableColumn fx:id="colEntrada" text="Entrada" prefWidth="100"/>
            <TableColumn fx:id="colSalida" text="Salida" prefWidth="100"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="110"/>
            <TableColumn fx:id="colValor" text="Valor" prefWidth="110"/>
            <TableColumn fx:id="colSaldo" text="Saldo" prefWidth="110"/>
        </columns>
    </TableView>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Monto:"/>
        <TextField fx:id="txtMonto" promptText="Ej: 84000" prefWidth="120"/>
        <Label text="Medio:"/>
        <ComboBox fx:id="cmbMedio"/>
        <Button text="Registrar pago" onAction="#registrarPago"/>
        <Button text="Ver devolución" onAction="#verDevolucion"/>
        <Button text="Cancelar reserva" onAction="#cancelarReserva"/>
    </HBox>
    <Label fx:id="lblMensaje" wrapText="true"/>
    <TextArea fx:id="txtDetalle" editable="false" VBox.vgrow="ALWAYS"/>
</VBox>